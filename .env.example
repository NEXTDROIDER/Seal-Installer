# Скопируйте в .env и запускайте: set -a; . ./.env; set +a; node server.js
PORT=8080
# HTTPS-адрес, по которому сервер виден снаружи (обязателен для установки на iOS)
PUBLIC_URL=https://example.trycloudflare.com
# js (встроенная подпись, по умолчанию) | zsign | api
SIGNER=js
# BUNDLE_ID=com.my.app   # принудительно сменить bundle id
ZSIGN_BIN=zsign
# SIGN_API_URL=https://api.daisign.lol/sign
# Папка с cert.p12, cert.mobileprovision, password.txt (или CERT_PASSWORD)
CERT_DIR=./certs
# CERT_PASSWORD=
# Если задан — API требует заголовок X-Token
# ACCESS_TOKEN=
MAX_SIZE_MB=500
TTL_MIN=60

# --- Автозагрузка ваших сертификатов из вашего API (каждые CERT_SYNC_MIN минут) ---
# CERT_API_URL=https://your-api.example.com
# CERT_API_PATH=/api/certificates/list/signed/5
# Заголовок Authorization целиком, напр. "Bearer xxx" или "token ghp_xxx" (уходит только на хост API и github)
# CERT_API_AUTH=
# CERT_SYNC_MIN=30
# Файлы качаются из {CERT_API_URL}/api/certificates/download/<id>/{cert.p12,cert.mobileprovision,password.txt}.
# Другой шаблон (по желанию): CERT_FILES_URL=https://host/path/{folder_name}/  (доступны {id} и {folder_name})
# CERT_P12_FILE=cert.p12
# CERT_PROFILE_FILE=cert.mobileprovision
# CERT_PASS_FILE=password.txt     # или CERT_PASSWORD=пароль
